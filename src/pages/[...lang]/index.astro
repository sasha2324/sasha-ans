---
// Home, una per lingua: / (italiano) e /en/ (inglese).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Projects from '../../components/Projects.astro';
import Path from '../../components/Path.astro';
import PostCard from '../../components/PostCard.astro';
import Icon from '../../components/Icon.astro';
import SectionHead from '../../components/SectionHead.astro';
import { profile } from '../../data/profilo';
import { loadPortfolioRepos } from '../../data/github';
import { showcase } from '../../lib/projects';
import { getPostsFor } from '../../lib/blog';
import type { Lang } from '../../i18n/ui';
import { langPaths, langPrefix, useTranslations } from '../../i18n/utils';

export const getStaticPaths = () => langPaths();

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);

// Progetti pubblici da GitHub (topic «portfolio») + schede scritte a mano di quelli privati
const projects = showcase(await loadPortfolioRepos(), lang);
const posts = (await getPostsFor(lang)).slice(0, 3);
---

<BaseLayout home>
  <div class="container home">
    <Hero />

    <Projects projects={projects} />

    <Path steps={profile.path} />

    <section id="studio" class="panel" aria-labelledby="studio-titolo">
      <SectionHead num="03" label={t('nav.its')} title={t('its.title')} titleId="studio-titolo" />
      <div class="soon">
        <span class="pill">{t('its.soon')}</span>
        <p>{t('its.text')}</p>
      </div>
    </section>

    <section id="articoli" class="panel" aria-labelledby="articoli-titolo">
      <SectionHead num="04" label={t('nav.posts')} title={t('posts.title')} titleId="articoli-titolo">
        <a slot="action" class="btn btn-secondary" href={`${langPrefix(lang)}/blog/`}>
          {t('posts.all')}<span class="arrow"><Icon name="arrow" /></span>
        </a>
      </SectionHead>
      {posts.length === 0 && <p class="empty">{t('blog.empty')}</p>}
      <div class="posts">
        {posts.map((item) => <PostCard item={item} />)}
      </div>
    </section>

    <section id="contatti" class="panel" aria-labelledby="contatti-titolo">
      <SectionHead
        num="05"
        label={t('nav.contact')}
        title={t('contact.title')}
        subtitle={t('contact.text')}
        titleId="contatti-titolo"
      />

      <div class="contact-cards">
        <article class="card contact-card">
          <p class="card-top">
            <span class="card-icon"><Icon name="sparkles" /></span>
            <span class="label">{t('contact.ideas.label')}</span>
          </p>
          <h3>{t('contact.ideas.title')}</h3>
          <p class="card-text">{t('contact.ideas.text')}</p>
        </article>
        <article class="card contact-card">
          <p class="card-top">
            <span class="card-icon"><Icon name="shield" /></span>
            <span class="label">{t('contact.study.label')}</span>
          </p>
          <h3>{t('contact.study.title')}</h3>
          <p class="card-text">{t('contact.study.text')}</p>
        </article>
      </div>

      <div class="dm">
        <a class="dm-btn" href={profile.linkedin.url} rel="me">
          <span class="dm-icon"><Icon name="linkedin" /></span>{t('contact.dm.linkedin')}
        </a>
        <a class="dm-btn" href={profile.x.url} rel="me">
          <span class="dm-icon"><Icon name="x" /></span>{t('contact.dm.x')}
        </a>
        <a class="dm-btn" href={profile.telegram.url} rel="me">
          <span class="dm-icon"><Icon name="telegram" /></span>{t('contact.dm.telegram')}
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    display: grid;
    gap: 20px;
    padding-top: 6rem;
    padding-bottom: var(--space-4);
  }

  .soon {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-5);
    padding: var(--space-5);
    border-radius: var(--radius-card);
    border: 1.5px dashed color-mix(in srgb, var(--muted) 45%, transparent);
  }

  .soon p {
    max-width: 52ch;
    color: var(--muted);
  }

  .posts {
    display: grid;
    gap: var(--space-3);
  }

  .empty {
    color: var(--muted);
  }

  /* ---------- 05 Contatti ---------- */
  .contact-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .contact-card {
    position: relative;
    overflow: hidden;
    padding: var(--space-6);
  }

  /* Un alone blu leggero nell'angolo, come quelli ai bordi della pagina */
  .contact-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      28rem 16rem at 100% 0%,
      color-mix(in srgb, var(--accent) 9%, transparent),
      transparent 70%
    );
    pointer-events: none;
  }

  .card-top {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .card-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--panel-strong);
    border: 1px solid var(--line);
    box-shadow: 0 1px 2px rgba(15, 23, 36, 0.06);
    color: var(--accent-text);
  }

  .card-icon :global(svg) {
    width: 19px;
    height: 19px;
  }

  .contact-card h3 {
    position: relative;
    margin-top: var(--space-5);
    font-size: var(--step-2);
  }

  .card-text {
    position: relative;
    margin-top: var(--space-2);
    color: var(--muted);
  }

  .dm {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  /* Pillola bianca con il logo nel cerchio blu */
  .dm-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 50px;
    padding: 6px 22px 6px 6px;
    border-radius: var(--radius-pill);
    background: var(--panel-strong);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    color: var(--ink);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 150ms ease;
  }

  .dm-btn:hover {
    transform: translateY(-1px);
  }

  .dm-icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent);
  }

  .dm-icon :global(svg) {
    width: 17px;
    height: 17px;
  }

  @media (max-width: 48rem) {
    .contact-cards {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 32rem) {
    .contact-card {
      padding: var(--space-5);
    }

    .dm-btn {
      flex: 1 1 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dm-btn:hover {
      transform: none;
    }
  }
</style>
