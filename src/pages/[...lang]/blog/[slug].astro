---
// Pagina di un articolo, nella lingua in cui è scritto: /blog/<slug>/, /en/blog/<slug>/.
// Il selettore di lingua porta alla traduzione se c'è, altrimenti al blog dell'altra lingua.
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LineSidebar from '../../../components/LineSidebar.astro';
import Icon from '../../../components/Icon.astro';
import { formatDate, getPosts, postSlug, readingMinutes, tagUrl, type Post } from '../../../lib/blog';
import type { Lang } from '../../../i18n/ui';
import { langPaths, langPrefix, langs, useTranslations } from '../../../i18n/utils';

export async function getStaticPaths() {
  const paths = [];
  for (const { params, props } of langPaths()) {
    for (const post of await getPosts(props.lang)) {
      paths.push({ params: { ...params, slug: postSlug(post) }, props: { lang: props.lang, post } });
    }
  }
  return paths;
}

const { lang, post } = Astro.props as { lang: Lang; post: Post };
const { Content, headings } = await render(post);
const t = useTranslations(lang);

const slug = postSlug(post);
const alternates: Partial<Record<Lang, string>> = {};
for (const l of langs) {
  const translated = (await getPosts(l)).some((p) => postSlug(p) === slug);
  alternates[l] = translated ? `${langPrefix(l)}/blog/${slug}/` : `${langPrefix(l)}/blog/`;
}
const translatedLangs = langs.filter((l) => alternates[l]?.endsWith(`/${slug}/`));

// Indice: solo i titoli di secondo livello (## nel Markdown)
const toc = headings.filter((h) => h.depth === 2).map((h) => ({ label: h.text, href: `#${h.slug}` }));
const { title, description, date, updated, tags, draft } = post.data;
const blogUrl = `${langPrefix(lang)}/blog/`;
---

<BaseLayout title={title} description={description} alternates={alternates} noAlternates={translatedLangs.length < 2}>
  <div class="container post-layout">
    <article class="panel post">
      <header class="post-header">
        <a class="back label" href={blogUrl}><span aria-hidden="true">←</span> {t('blog.back')}</a>
        <h1>{title}</h1>
        <p class="label meta">
          <time datetime={date.toISOString()}>{formatDate(date, lang)}</time>
          <span>{readingMinutes(post)} {t('blog.minutes')}</span>
          {
            updated && (
              <span>
                {t('blog.updated')} <time datetime={updated.toISOString()}>{formatDate(updated, lang)}</time>
              </span>
            )
          }
          {draft && <span class="pill">{t('blog.draft')}</span>}
        </p>
        <p class="lead">{description}</p>
        {
          tags.length > 0 && (
            <ul class="tags" aria-label={t('blog.tags')}>
              {tags.map((tag) => (
                <li>
                  <a class="label" href={tagUrl(tag, lang)}>
                    #{tag}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </header>

      {
        toc.length > 0 && (
          <details class="toc-mobile">
            <summary>{t('blog.toc')}</summary>
            <LineSidebar items={toc} label={t("blog.toc")} current="location" class="toc-nav" fontSize={0.9} maxShift={14} markerLength={32} itemGap={14} />
          </details>
        )
      }

      <div class="prose">
        <Content />
      </div>

      <footer class="post-footer">
        <a class="btn btn-secondary" href={blogUrl}>
          {t('blog.back')}<span class="arrow"><Icon name="arrow" /></span>
        </a>
      </footer>
    </article>

    {
      toc.length > 0 && (
        <aside class="toc">
          <p class="label">// {t('blog.toc')}</p>
          <LineSidebar items={toc} label={t("blog.toc")} current="location" class="toc-nav" fontSize={0.9} maxShift={14} markerLength={32} itemGap={14} />
        </aside>
      )
    }
  </div>
</BaseLayout>

<script>
  // Accende nell'indice la sezione che si sta leggendo.
  const headings = Array.from(document.querySelectorAll<HTMLElement>('.prose h2[id]'));
  const navs = Array.from(document.querySelectorAll<HTMLElement>('.toc-nav'));
  let current: number | null = null;
  let scheduled = false;

  const update = () => {
    scheduled = false;
    const line = window.innerHeight * 0.3;
    let index: number | null = null;
    headings.forEach((h, i) => {
      if (h.getBoundingClientRect().top <= line) index = i;
    });
    if (index === current) return;
    current = index;
    navs.forEach((nav) => nav.dispatchEvent(new CustomEvent('linesidebar:active', { detail: index })));
  };

  if (headings.length && navs.length) {
    update();
    window.addEventListener(
      'scroll',
      () => {
        if (scheduled) return;
        scheduled = true;
        requestAnimationFrame(update);
      },
      { passive: true }
    );
  }
</script>

<style>
  .post-layout {
    display: grid;
    gap: var(--space-5);
    padding-top: 6rem;
    padding-bottom: var(--space-5);
  }

  .post {
    min-width: 0;
  }

  .post > * {
    max-width: var(--measure);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    margin-bottom: var(--space-4);
    text-decoration: none;
  }

  .back:hover {
    color: var(--accent-text);
  }

  .post-header h1 {
    margin-bottom: var(--space-4);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
  }

  .lead {
    margin-top: var(--space-5);
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin-top: var(--space-4);
    list-style: none;
    padding: 0;
  }

  .tags a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    text-decoration: none;
  }

  .tags a:hover {
    color: var(--accent-text);
  }

  .toc-mobile {
    margin-top: var(--space-6);
    padding: var(--space-2) var(--space-4) var(--space-4);
    border-radius: var(--radius-card);
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--panel-strong) 60%, transparent);
  }

  .toc-mobile summary {
    min-height: 44px;
    display: flex;
    align-items: center;
    cursor: pointer;
    font-weight: 600;
  }

  .toc {
    display: none;
  }

  .post-footer {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
  }

  /* Schermi larghi: indice fisso a destra, in un piccolo pannello */
  @media (min-width: 72rem) {
    .post-layout {
      grid-template-columns: minmax(0, 1fr) 16rem;
      align-items: start;
    }

    .toc {
      display: block;
      position: sticky;
      top: 6rem;
      max-height: calc(100vh - 7.5rem);
      overflow-y: auto;
      overflow-x: hidden;
      padding: var(--space-5) var(--space-6) var(--space-5) var(--space-5);
      border-radius: var(--radius-card);
      background: color-mix(in srgb, var(--panel) 74%, transparent);
      -webkit-backdrop-filter: blur(18px) saturate(140%);
      backdrop-filter: blur(18px) saturate(140%);
      border: 1px solid var(--line);
      box-shadow: var(--shadow);
    }

    .toc .label {
      margin-bottom: var(--space-3);
    }

    .toc-mobile {
      display: none;
    }
  }

  /* ---------- Testo dell'articolo (Markdown) ---------- */

  .prose {
    margin-top: var(--space-7);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .prose :global(> * + *) {
    margin-top: var(--space-4);
  }

  .prose :global(h2) {
    margin-top: var(--space-8);
    font-size: var(--step-3);
  }

  .prose :global(h3) {
    margin-top: var(--space-6);
    font-size: var(--step-2);
  }

  .prose :global(h2 + *),
  .prose :global(h3 + *) {
    margin-top: var(--space-3);
  }

  .prose :global(a) {
    color: var(--accent-text);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: var(--space-5);
  }

  .prose :global(li + li) {
    margin-top: var(--space-2);
  }

  .prose :global(li::marker) {
    color: var(--muted);
  }

  .prose :global(strong) {
    font-weight: 600;
  }

  .prose :global(blockquote) {
    padding: var(--space-3) var(--space-5);
    border-left: 3px solid var(--accent);
    border-radius: 0 12px 12px 0;
    background: color-mix(in srgb, var(--accent) 6%, transparent);
    color: var(--muted);
  }

  .prose :global(:not(pre) > code) {
    padding: 0.1em 0.4em;
    border-radius: 6px;
    background: color-mix(in srgb, var(--panel-strong) 80%, transparent);
    border: 1px solid var(--line);
    font-size: 0.88em;
  }

  .prose :global(pre) {
    padding: var(--space-4) var(--space-5);
    border-radius: 16px;
    border: 1px solid var(--line);
    overflow-x: auto;
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .prose :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--line);
    text-align: left;
  }

  .prose :global(th) {
    font-weight: 600;
  }

  .prose :global(hr) {
    margin-block: var(--space-7);
    border: 0;
    border-top: 1px dashed color-mix(in srgb, var(--muted) 60%, transparent);
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 16px;
    border: 1px solid var(--line);
  }
</style>
