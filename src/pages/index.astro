---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Skills from '../components/Skills.astro';
import { profile } from '../data/it/profilo';

const { name, intro, path, skills, projects, github } = profile;
---

<BaseLayout home>
  <Hero name={name} headline={intro.headline} steps={path} />

  <section class="section container about" aria-labelledby="chi-sono-titolo">
    <h2 id="chi-sono-titolo">Chi sono</h2>
    <div>
      {intro.text.map((paragraph) => <p class="lead">{paragraph}</p>)}
      <p class="languages">{intro.languages}</p>
    </div>
  </section>

  <Skills have={skills.have} learning={skills.learning} />

  {
    projects.length > 0 && (
      <section class="section container" aria-labelledby="progetti-titolo">
        <h2 id="progetti-titolo">Progetti</h2>
        <ul class="projects">
          {projects.map((project) => (
            <li>
              <h3>{project.url ? <a href={project.url}>{project.title}</a> : project.title}</h3>
              <p>{project.description}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="section container contact" aria-labelledby="contatti-titolo">
    <h2 id="contatti-titolo">Contatti</h2>
    <p>Il codice dei miei progetti e di questo sito è su GitHub.</p>
    <a class="button selectable" href={github.url} rel="me">Apri il profilo GitHub</a>
  </section>
</BaseLayout>

<style>
  .section {
    padding-block: var(--space-7);
  }

  .section h2 {
    margin-bottom: var(--space-5);
  }

  .about {
    border-top: 1px solid var(--hairline);
  }

  .lead {
    font-size: var(--step-1);
    line-height: 1.5;
    margin-bottom: var(--space-3);
    max-width: 52ch;
  }

  .languages {
    margin-top: var(--space-5);
    color: var(--muted);
  }

  .contact p {
    margin-bottom: var(--space-5);
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-2) var(--space-5);
    border: 1px solid var(--ink);
    color: var(--ink);
    font-weight: 500;
    text-decoration: none;
  }

  .projects {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 48rem) {
    .section {
      padding-block: var(--space-8);
    }

    .about {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: var(--space-6);
    }
  }
</style>
