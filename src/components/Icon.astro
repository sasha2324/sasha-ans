---
// Icone SVG del sito, sempre decorative (aria-hidden): il testo va messo accanto
// o nell'aria-label del link. GitHub, LinkedIn, X e Telegram sono i loghi ufficiali semplificati.
interface Props {
  name: 'arrow' | 'external' | 'github' | 'linkedin' | 'x' | 'telegram' | 'sun' | 'moon' | 'sparkles' | 'shield';
  class?: string;
}

const { name, class: className } = Astro.props;
const stroke = { fill: 'none', stroke: 'currentColor', 'stroke-width': 2.4, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' } as const;
---

{name === 'arrow' && (
  <svg class={className} viewBox="0 0 24 24" aria-hidden="true" {...stroke}><path d="M5 12h14M13 6l6 6-6 6" /></svg>
)}
{name === 'external' && (
  <svg class={className} viewBox="0 0 24 24" aria-hidden="true" {...stroke}><path d="M7 17 17 7M8 7h9v9" /></svg>
)}
{name === 'sun' && (
  <svg class={className} viewBox="0 0 24 24" aria-hidden="true" {...stroke} stroke-width="2">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
)}
{name === 'moon' && (
  <svg class={className} viewBox="0 0 24 24" aria-hidden="true" {...stroke} stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
)}
{name === 'github' && (
  <svg class={className} viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
    <path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3" />
  </svg>
)}
{name === 'linkedin' && (
  <svg class={className} viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
    <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" />
  </svg>
)}
{name === 'x' && (
  <svg class={className} viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
    <path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.58-6.64 7.58H.47l8.6-9.83L0 1.15h7.6l5.24 6.93 6.06-6.93zm-1.29 19.5h2.04L6.49 3.24H4.3z" />
  </svg>
)}
{name === 'telegram' && (
  <svg class={className} viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
    <path d="M12 0a12 12 0 1 0 0 24 12 12 0 0 0 0-24zm4.96 7.22c.1 0 .32.02.47.14.12.1.15.23.17.33.02.09.04.3.02.47-.18 1.9-.96 6.5-1.36 8.63-.17.9-.5 1.2-.82 1.23-.7.06-1.22-.46-1.9-.9-1.06-.7-1.65-1.13-2.68-1.8-1.18-.78-.42-1.21.26-1.91.18-.19 3.25-2.98 3.3-3.23.01-.03.02-.15-.05-.21-.07-.06-.18-.04-.25-.03-.1.03-1.8 1.14-5.06 3.35-.48.33-.91.49-1.3.48-.43-.01-1.25-.24-1.87-.44-.75-.25-1.35-.37-1.3-.79.03-.22.33-.44.9-.66 3.5-1.52 5.83-2.53 7-3.01 3.33-1.39 4.02-1.63 4.47-1.64z" />
  </svg>
)}
{name === 'sparkles' && (
  <svg class={className} viewBox="0 0 24 24" aria-hidden="true" {...stroke} stroke-width="1.8">
    <path d="M10 3.5l1.6 4.4 4.4 1.6-4.4 1.6L10 15.5l-1.6-4.4L4 9.5l4.4-1.6z" />
    <path d="M17.5 13.5l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8z" />
  </svg>
)}
{name === 'shield' && (
  <svg class={className} viewBox="0 0 24 24" aria-hidden="true" {...stroke} stroke-width="1.8">
    <path d="M12 3l7 3v5.5c0 4.3-2.9 8-7 9.5-4.1-1.5-7-5.2-7-9.5V6z" />
    <path d="M9 12l2 2 4-4" />
  </svg>
)}
