---
import { profile } from '../data/it/profilo';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const t = useTranslations(getLangFromUrl(Astro.url));
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <p>© {year} Sasha</p>
    <div class="links">
      <a class="selectable" href="/rss.xml">{t('footer.rss')}</a>
      <a class="selectable" href={profile.github.url} rel="me">{t('footer.github')}</a>
      <a class="selectable" href={profile.telegram.url} rel="me">{t('footer.telegram')}</a>
      <a class="selectable" href={profile.instagram.url} rel="me">{t('footer.instagram')}</a>
      <a class="selectable" href={profile.x.url} rel="me">{t('footer.x')}</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--hairline);
    color: var(--muted);
    font-size: var(--step--1);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-5);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
