---
// 01 Progetti: una scheda grande per progetto, immagine a sinistra e testo a destra
// (su telefono l'immagine sta sopra). I dati arrivano da src/lib/projects.ts:
// prima i repository pubblici di GitHub, poi i progetti privati scritti a mano.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { ShowcaseProject } from '../lib/projects';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  projects: ShowcaseProject[];
}

const { projects } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
const nn = (i: number) => String(i + 1).padStart(2, '0');
---

<section id="progetti" class="panel" aria-labelledby="progetti-titolo">
  <div class="section-head">
    <div>
      <p class="label"><span class="num">01</span> // {t('nav.projects')}</p>
      <h2 id="progetti-titolo">{t('projects.title')}</h2>
    </div>
  </div>

  <div class="projects">
    {
      projects.map((project, i) => (
        <article
          class="card project"
          id={`progetto-${project.id}`}
          data-state={project.done ? 'done' : 'current'}
          aria-labelledby={`progetto-${project.id}-titolo`}
        >
          <div class="shot">
            {project.image ? (
              <Image
                src={project.image}
                alt={project.imageAlt}
                widths={[480, 720, 960, 1280]}
                sizes="(min-width: 54rem) 560px, calc(100vw - 4rem)"
                loading="lazy"
              />
            ) : (
              <span class="placeholder label" aria-hidden="true">
                {project.title}
              </span>
            )}
          </div>

          <div class="body">
            <p class="meta">
              <span class="pill">{nn(i)}</span>
              {project.category && <span class="label">{project.category}</span>}
            </p>
            <h3 id={`progetto-${project.id}-titolo`}>{project.title}</h3>
            {project.description && <p class="description">{project.description}</p>}
            {project.url ? (
              <a class="btn btn-secondary" href={project.url}>
                {t('projects.code')}
                <span class="arrow">
                  <Icon name="external" />
                </span>
              </a>
            ) : (
              <span class="btn btn-muted">{t('projects.private')}</span>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .projects {
    display: grid;
    gap: var(--space-4);
  }

  .project {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding: 14px;
  }

  .shot {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 18px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--accent) 8%, var(--bg));
  }

  .shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Finché non c'è l'immagine: riquadro a righe con il nome */
  .placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: repeating-linear-gradient(
      135deg,
      transparent 0 14px,
      color-mix(in srgb, var(--accent) 7%, transparent) 14px 15px
    );
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-4) var(--space-3) 0;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  h3 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
  }

  .description {
    color: var(--muted);
  }

  .body .btn {
    margin-top: auto;
    align-self: flex-start;
  }

  @media (max-width: 54rem) {
    .project {
      grid-template-columns: 1fr;
    }

    .body {
      padding: var(--space-1) var(--space-2) var(--space-2);
    }

    .body .btn {
      margin-top: var(--space-2);
    }
  }
</style>
