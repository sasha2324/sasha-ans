---
interface Props {
  have: string[];
  learning: string[];
}

const { have, learning } = Astro.props;
---

<section class="section" aria-labelledby="competenze-titolo">
  <div class="container">
    <h2 id="competenze-titolo">Competenze</h2>
    <div class="columns">
      <div class="group" data-kind="have">
        <h3><span class="legend" aria-hidden="true"></span>So usare</h3>
        <ul>{have.map((item) => <li>{item}</li>)}</ul>
      </div>
      <div class="group" data-kind="learning">
        <h3><span class="legend" aria-hidden="true"></span>Sto imparando</h3>
        <ul>{learning.map((item) => <li>{item}</li>)}</ul>
      </div>
    </div>
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-7);
  }

  h2 {
    margin-bottom: var(--space-6);
  }

  .columns {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 48rem) {
    .section {
      padding-block: var(--space-8);
    }

    .columns {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
    }
  }

  h3 {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--step-1);
    margin-bottom: var(--space-4);
  }

  /* Legenda: lo stesso bordo usato dalle voci sotto */
  .legend {
    width: 1.5rem;
    border-top: 1.5px solid var(--ink);
  }

  [data-kind='learning'] .legend {
    border-top-style: dashed;
    border-top-color: var(--muted);
  }

  ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  li {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--ink);
    line-height: 1.4;
  }

  [data-kind='learning'] li {
    border-style: dashed;
    border-color: var(--muted);
  }
</style>
