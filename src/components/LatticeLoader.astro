---
/*
 * Lattice Loader — griglia di puntini che si accendono in sequenza, poi una ✓.
 *
 * Adattato da React Bits (https://reactbits.dev, https://github.com/DavidHDev/react-bits).
 * Modifiche: rimosso React (la griglia è generata durante la build), tolto lo stato
 * di errore, ✓ dello stesso colore dei puntini. Lo stato e il cronometro li gestisce
 * src/scripts/intro.ts tramite gli attributi data-*.
 *
 * MIT + Commons Clause License Condition v1.0 — Copyright (c) 2026 David Haz.
 * Testo completo della licenza in src/scripts/pattern-waves.ts.
 */

type Grid = 3 | 4;
type Pattern = { cells: (number | null)[]; loop: number; scale: number; lit?: number };

const PATTERNS: Record<string, Partial<Record<Grid, Pattern>>> = {
  arrow: { 3: { cells: [1, 2, 3, 0, 1, 2, 1, 2, 3], loop: 7.2, scale: 1 } },
  dots: { 3: { cells: [0, 1, 2, 0, 1, 2, 0, 1, 2], loop: 3, scale: 2.4 } },
  ripple: { 3: { cells: [2, 1, 2, 1, 0, 1, 2, 1, 2], loop: 4.8, scale: 1.5 } },
  spiral: { 3: { cells: [0, 1, 2, 7, 8, 3, 6, 5, 4], loop: 9, scale: 1.2, lit: 0.35 } },
  orbit: {
    3: { cells: [0, 1, 2, 7, null, 3, 6, 5, 4], loop: 8, scale: 1.2 },
    4: { cells: [0, 1, 2, 3, 11, null, null, 4, 10, null, null, 5, 9, 8, 7, 6], loop: 6, scale: 1.2, lit: 0.45 }
  },
  snake: {
    3: { cells: [0, 1, 2, 5, 4, 3, 6, 7, 8], loop: 9, scale: 1, lit: 0.35 },
    4: { cells: [0, 1, 2, 3, 7, 6, 5, 4, 8, 9, 10, 11, 15, 14, 13, 12], loop: 16, scale: 1, lit: 0.25 }
  },
  sweep: { 4: { cells: [0, 1, 2, 3, 1, 2, 3, 4, 2, 3, 4, 5, 3, 4, 5, 6], loop: 5, scale: 1, lit: 0.45 } },
  spin: { 4: { cells: [0, 0, 1, 1, 0, 0, 1, 1, 3, 3, 2, 2, 3, 3, 2, 2], loop: 4, scale: 1.6, lit: 0.35 } },
  rain: { 4: { cells: [0, 2, 1, 3, 1, 3, 2, 4, 2, 4, 3, 5, 3, 5, 4, 6], loop: 4, scale: 1.2, lit: 0.35 } },
  pulse: { 4: { cells: [2, 1, 1, 2, 1, 0, 0, 1, 1, 0, 0, 1, 2, 1, 1, 2], loop: 2.4, scale: 2.5, lit: 0.45 } }
};
const DEFAULT_PATTERN: Record<Grid, string> = { 3: 'orbit', 4: 'sweep' };
const DONE_MARK: Record<Grid, number[]> = { 3: [2, 3, 5, 7], 4: [7, 8, 10, 13] };

interface Props {
  label?: string;
  doneLabel?: string;
  pattern?: string;
  grid?: Grid;
  shape?: 'square' | 'round';
  cellSize?: number;
  gap?: number;
  fontSize?: number;
  step?: number;
  idleOpacity?: number;
  showTimer?: boolean;
  class?: string;
}

const {
  label = 'Loading',
  doneLabel = 'Ready in',
  pattern = 'orbit',
  grid = 3,
  shape = 'round',
  cellSize = 6,
  gap = 2,
  fontSize = 14,
  step = 90,
  idleOpacity = 0.15,
  showTimer = true,
  class: className = ''
} = Astro.props;

const n: Grid = grid === 4 ? 4 : 3;
const pat = PATTERNS[pattern]?.[n] ?? (PATTERNS[DEFAULT_PATTERN[n]][n] as Pattern);
const d = step * pat.scale;
const cycle = Math.round(pat.loop * d);
const lit = pat.lit && pat.lit !== 0.62 ? Math.round(pat.lit * 100) : undefined;
const mark = DONE_MARK[n];

const vars = [
  `--ll-n: ${n}`,
  `--ll-cell: ${cellSize}px`,
  `--ll-gap: ${gap}px`,
  `--ll-font: ${fontSize}px`,
  `--ll-idle: ${idleOpacity}`,
  `--ll-cycle: ${cycle}ms`
].join('; ');
---

<span
  role="status"
  class:list={['lattice-loader', className]}
  data-status="working"
  data-shape={shape}
  data-label={label}
  data-done-label={doneLabel}
  style={vars}
>
  <span class="grid" aria-hidden="true">
    <span class="layer run">
      {
        pat.cells.map((unit) => (
          <span
            class="cell"
            data-hole={unit == null ? '' : undefined}
            data-lit={lit}
            style={unit == null ? undefined : `animation-delay: ${Math.round(unit * d)}ms`}
          />
        ))
      }
    </span>
    <span class="layer mark">
      {pat.cells.map((_, i) => <span class="cell" data-on={mark.includes(i) ? '' : undefined} />)}
    </span>
  </span>
  <span class="label" aria-hidden="true">
    <span class="text" data-active="">{label}</span>
    <span class="text">{doneLabel}</span>
  </span>
  {showTimer && <span class="timer" aria-hidden="true">0.0s</span>}
  <span class="sr">{label}, in progress</span>
</span>

<style>
  .lattice-loader {
    --ll-peak: 1;
    --ll-ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    --ll-ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);

    position: relative;
    display: inline-flex;
    align-items: center;
    gap: calc(var(--ll-font) * 0.625);
    font-size: var(--ll-font);
    line-height: 1;
    color: var(--ink);
  }

  .grid {
    display: grid;
    flex: none;
  }

  .layer {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: repeat(var(--ll-n), var(--ll-cell));
    gap: var(--ll-gap);
  }

  .cell {
    width: var(--ll-cell);
    height: var(--ll-cell);
    border-radius: max(1px, calc(var(--ll-cell) * 0.25));
    background: currentColor;
    opacity: var(--ll-idle);
  }

  [data-shape='round'] .cell {
    border-radius: 50%;
  }

  .run {
    transition: opacity 200ms ease;
  }

  .run .cell {
    animation: lattice-on var(--ll-cycle) var(--ll-ease-in-out) infinite;
  }

  .run .cell[data-lit='45'] {
    animation-name: lattice-on-45;
  }

  .run .cell[data-lit='35'] {
    animation-name: lattice-on-35;
  }

  .run .cell[data-lit='25'] {
    animation-name: lattice-on-25;
  }

  .run .cell[data-hole] {
    animation: none;
    opacity: calc(var(--ll-idle) * 0.47);
  }

  .mark {
    opacity: 0;
    transform: scale(0.9);
    transform-origin: center;
    transition:
      opacity 160ms var(--ll-ease-out),
      transform 160ms var(--ll-ease-out);
  }

  .mark .cell {
    transition: opacity 200ms ease;
  }

  .mark .cell[data-on] {
    opacity: var(--ll-peak);
  }

  [data-status='done'] .run {
    opacity: 0;
  }

  [data-status='done'] .run .cell {
    animation-play-state: paused;
  }

  [data-status='done'] .mark {
    opacity: 1;
    transform: none;
    transition:
      opacity 200ms ease,
      transform 200ms var(--ll-ease-out);
  }

  .label {
    position: relative;
    display: inline-block;
    font-weight: 500;
  }

  .text {
    position: absolute;
    top: 0;
    left: 0;
    white-space: nowrap;
    opacity: 0;
    filter: blur(2px);
    transition:
      opacity 200ms ease,
      filter 200ms ease;
  }

  .text[data-active] {
    position: static;
    opacity: 1;
    filter: blur(0);
  }

  .timer {
    font-family: var(--font-mono);
    font-size: calc(var(--ll-font) * 0.875);
    font-variant-numeric: tabular-nums;
    opacity: 0.6;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @keyframes lattice-on {
    0%,
    100% {
      opacity: var(--ll-idle);
    }
    18%,
    42% {
      opacity: var(--ll-peak);
    }
    62% {
      opacity: var(--ll-idle);
    }
  }

  @keyframes lattice-on-45 {
    0%,
    100% {
      opacity: var(--ll-idle);
    }
    13%,
    31% {
      opacity: var(--ll-peak);
    }
    45% {
      opacity: var(--ll-idle);
    }
  }

  @keyframes lattice-on-35 {
    0%,
    100% {
      opacity: var(--ll-idle);
    }
    10%,
    24% {
      opacity: var(--ll-peak);
    }
    35% {
      opacity: var(--ll-idle);
    }
  }

  @keyframes lattice-on-25 {
    0%,
    100% {
      opacity: var(--ll-idle);
    }
    7%,
    17% {
      opacity: var(--ll-peak);
    }
    25% {
      opacity: var(--ll-idle);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .run {
      --ll-peak: 0.7;
    }
    .run .cell {
      animation-delay: 0ms !important;
      animation-duration: 1400ms !important;
    }
    .mark {
      transform: none;
    }
    .text {
      filter: none;
    }
  }
</style>
