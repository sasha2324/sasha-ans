---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const t = useTranslations(getLangFromUrl(Astro.url));
---

<button
  class="theme-toggle selectable"
  type="button"
  data-label-dark={t('theme.toDark')}
  data-label-light={t('theme.toLight')}
  aria-label={t('theme.toDark')}
>
  <!-- Luna: mostrata nel tema chiaro -->
  <svg class="icon-moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <path
      d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linejoin="round"></path>
  </svg>
  <!-- Sole: mostrato nel tema scuro -->
  <svg class="icon-sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <path
      d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: transparent;
    color: var(--ink);
    border: 0;
    border-radius: var(--radius);
    cursor: pointer;
  }

  .icon-sun {
    display: none;
  }

  :global(:root[data-theme='dark']) .icon-sun {
    display: block;
  }

  :global(:root[data-theme='dark']) .icon-moon {
    display: none;
  }
</style>

<script>
  // Il tema iniziale viene impostato dallo script nell'<head> (BaseLayout).
  // Qui gestiamo solo il clic e l'etichetta per gli screen reader.
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');

  function updateLabel() {
    if (!button) return;
    const isDark = document.documentElement.dataset.theme === 'dark';
    button.setAttribute(
      'aria-label',
      (isDark ? button.dataset.labelLight : button.dataset.labelDark) ?? '',
    );
  }

  button?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Navigazione privata o storage bloccato: il tema vale solo per questa pagina.
    }
    updateLabel();
  });

  updateLabel();
</script>
