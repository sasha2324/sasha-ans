---
// Prima schermata della home: titolo TechText e frase di presentazione, sopra lo sfondo
// globale (Background.astro). Contiene il loader e la parte "contenuti" della sequenza
// di ingresso (src/scripts/intro.ts); la parte "finestra" è in Background.astro.
import LatticeLoader from './LatticeLoader.astro';
import Path from './Path.astro';
import type { PathStep } from '../data/it/profilo';

interface Props {
  name: string;
  headline: string;
  steps: PathStep[];
}

const { name, headline, steps } = Astro.props;
---

<section class="hero" aria-labelledby="hero-titolo">
  <div class="scrim" aria-hidden="true"></div>

  <div class="content container">
    <!-- Titolo vero (per screen reader e motori di ricerca); senza JavaScript è anche quello visibile -->
    <h1 id="hero-titolo" class="title-text">{name}</h1>
    <div class="title-canvas" data-techtext data-text={name}></div>
    <div class="bottom">
      <p class="headline">{headline}</p>
      <Path steps={steps} compact />
    </div>
  </div>

  <div class="intro-loader" data-intro-loader>
    <LatticeLoader />
  </div>
</section>

<script>
  import { mountTechText } from '../scripts/tech-text';
  import '../scripts/intro';

  const root = document.documentElement;

  const css = getComputedStyle(root);
  const ink = css.getPropertyValue('--ink').trim() || '#ffffff';
  const bg = css.getPropertyValue('--bg').trim() || '#000000';
  const font = css.getPropertyValue('--font-display').trim();

  const titleEl = document.querySelector<HTMLElement>('[data-techtext]');
  const title = titleEl
    ? mountTechText(titleEl, {
        text: titleEl.dataset.text ?? 'Sasha',
        fontFamily: font,
        fontWeight: 700, // originale 600: lettere più piene, più leggibili sullo sfondo
        fontSize: 320, // originale 150: titolo più grande (si riduce da solo se non c'è spazio)
        reveal: 'letter',
        dashLength: 4,
        dashGap: 2,
        specks: 15,
        color: ink,
        accentColor: ink,
        haloColor: bg, // alone nero attorno alle lettere: le stacca dai puntini
        haloBlur: 28
      })
    : null;
  if (title) root.classList.add('techtext-ready');
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    isolation: isolate; /* il velo con z-index -1 resta dentro la hero, sopra lo sfondo */
  }

  /* Velo in basso per leggere il testo sopra i puntini (come lo "scrim" di ScrollExpand) */
  .scrim {
    position: absolute;
    inset: 0;
    z-index: -1; /* dietro al testo */
    pointer-events: none;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--bg) 85%, transparent),
      transparent 45%,
      color-mix(in srgb, var(--bg) 35%, transparent)
    );
  }

  .content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-top: 4.5rem; /* spazio per il bottone Menu su telefono */
    padding-bottom: var(--space-7);
  }

  @media (min-width: 64rem) {
    .content {
      padding-top: var(--space-6);
    }
  }

  .title-canvas {
    height: clamp(11rem, 40vh, 28rem);
    touch-action: pan-y;
    user-select: none;
  }

  /* Senza JavaScript (o se il canvas non parte) si vede il titolo in HTML */
  .title-text {
    font-size: clamp(5rem, 20vw, 14rem);
    font-weight: 700;
    text-align: center;
    letter-spacing: -0.05em;
    padding-top: var(--space-6);
  }

  :global(html.techtext-ready) .title-text {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  :global(html:not(.techtext-ready)) .title-canvas {
    display: none;
  }

  .bottom {
    display: grid;
    gap: var(--space-6);
  }

  .headline {
    max-width: 22ch;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-3);
    line-height: 1.15;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .intro-loader {
    display: none;
  }

  /* ---------- Sequenza di ingresso ---------- */

  :global(html.intro) {
    overflow: hidden;
  }

  :global(html.intro) .scrim {
    opacity: 0;
    transition: opacity 1100ms ease;
  }

  :global(html.intro) .content,
  :global(html.intro .site-nav) {
    opacity: 0;
    transform: translate3d(0, 18px, 0);
    transition:
      opacity 500ms ease,
      transform 500ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  :global(html.intro) .intro-loader {
    display: flex;
    justify-content: center;
    position: fixed; /* centrato sullo schermo, come la finestra dello sfondo */
    inset: auto 0 calc(21% - 3.5rem);
    transition: opacity 300ms ease;
  }

  :global(html.intro-open) .scrim {
    opacity: 1;
  }

  :global(html.intro-open) .intro-loader {
    opacity: 0;
  }

  :global(html.intro-reveal) .content,
  :global(html.intro-reveal .site-nav) {
    opacity: 1;
    transform: none;
  }

  /* Su telefono la finestra iniziale è più larga (vedi Background.astro): il loader la segue */
  @media (max-width: 47.99rem) {
    :global(html.intro) .intro-loader {
      inset: auto 0 calc(24% - 3.5rem);
    }
  }
</style>
