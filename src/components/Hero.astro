---
// Intro della home: etichetta, «Ciao! Sono» e il nome disegnato con TechText (React Bits),
// una frase, i pulsanti verso progetti e blog, LinkedIn e GitHub.
// Senza JavaScript (o se il canvas non parte) si vede il titolo in HTML.
import Icon from './Icon.astro';
import { profile } from '../data/profilo';
import { getLangFromUrl, langPrefix, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { name } = profile;
---

<section class="panel hero" aria-labelledby="hero-titolo">
  <p class="badge label"><span class="dot" aria-hidden="true"></span>{t('hero.label')}</p>

  <!-- Titolo vero, per screen reader e motori di ricerca -->
  <h1 id="hero-titolo" class="title-text">{t('hero.hi')} {name}</h1>
  <div class="title-visual" aria-hidden="true">
    <p class="hi">{t('hero.hi')}</p>
    <div class="title-canvas" data-techtext data-text={name}></div>
  </div>

  <p class="lead">{t('hero.lead')}</p>

  <div class="actions">
    <a class="btn btn-primary" href="#progetti">
      {t('hero.projects')}<span class="arrow"><Icon name="arrow" /></span>
    </a>
    <a class="btn btn-secondary" href={`${langPrefix(lang)}/blog/`}>
      {t('hero.blog')}<span class="arrow"><Icon name="arrow" /></span>
    </a>
    <div class="socials">
      <a class="icon-btn" href={profile.linkedin.url} rel="me" aria-label="LinkedIn"><Icon name="linkedin" /></a>
      <a class="icon-btn" href={profile.github.url} rel="me" aria-label="GitHub"><Icon name="github" /></a>
    </div>
  </div>
</section>

<script>
  import { mountTechText } from '../scripts/tech-text';

  const root = document.documentElement;
  const titleEl = document.querySelector<HTMLElement>('[data-techtext]');

  const colors = () => {
    const css = getComputedStyle(root);
    return {
      color: css.getPropertyValue('--ink').trim() || '#0f1724',
      // tratteggio, lente, puntini e cornice di selezione nel colore d'accento
      accentColor: css.getPropertyValue('--accent-text').trim() || '#2445d6'
    };
  };

  const title = titleEl
    ? mountTechText(titleEl, {
        text: titleEl.dataset.text ?? 'Sasha',
        fontFamily: getComputedStyle(root).getPropertyValue('--font-display').trim(),
        fontWeight: 700, // originale 600: lettere più piene
        fontSize: 320, // originale 150: si riduce da solo se non c'è spazio
        reveal: 'letter',
        dashLength: 4,
        dashGap: 2,
        specks: 15,
        align: 'left', // allineato al resto dell'intro
        ...colors()
      })
    : null;

  if (title) {
    root.classList.add('techtext-ready');
    document.addEventListener('themechange', () => title.set(colors()));
  }
</script>

<style>
  .hero {
    padding-block: clamp(2.5rem, 7vw, 5.5rem);
    overflow: hidden;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    background: var(--panel-strong);
    border: 1px solid var(--line);
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 20%, transparent);
  }

  /* Senza JavaScript: titolo in HTML */
  .title-text {
    margin-block: var(--space-5) var(--space-4);
    font-size: clamp(2.9rem, 8vw, 6rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .title-visual {
    display: none;
  }

  /* Con TechText pronto: «Ciao! Sono» in HTML, il nome nel canvas */
  :global(html.techtext-ready) .title-text {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  :global(html.techtext-ready) .title-visual {
    display: block;
    margin-block: var(--space-5) var(--space-2);
  }

  .hi {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.2rem, 5.5vw, 4rem);
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .title-canvas {
    /* il canvas lascia 16 px a sinistra per la cornice: si sposta indietro di altrettanto */
    margin-left: -16px;
    height: clamp(7.5rem, 19vw, 14rem);
    touch-action: pan-y;
    user-select: none;
  }

  .lead {
    max-width: 40ch;
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .socials {
    display: flex;
    gap: var(--space-2);
  }

  @media (max-width: 32rem) {
    .actions .btn {
      flex: 1 1 100%;
      justify-content: space-between;
    }
  }
</style>
