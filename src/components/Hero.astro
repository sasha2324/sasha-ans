---
// Prima schermata della home: sfondo Pattern Waves, titolo TechText, frase di presentazione.
// Contiene anche il loader e le regole CSS della sequenza di ingresso (src/scripts/intro.ts).
import LatticeLoader from './LatticeLoader.astro';

interface Props {
  name: string;
  headline: string;
}

const { name, headline } = Astro.props;
---

<section class="hero" aria-labelledby="hero-titolo">
  <div class="stage" aria-hidden="true">
    <div class="waves" data-waves></div>
    <div class="scrim"></div>
  </div>

  <div class="content container">
    <!-- Titolo vero (per screen reader e motori di ricerca); senza JavaScript è anche quello visibile -->
    <h1 id="hero-titolo" class="title-text">{name}</h1>
    <div class="title-canvas" data-techtext data-text={name}></div>
    <p class="headline">{headline}</p>
  </div>

  <div class="intro-loader" data-intro-loader>
    <LatticeLoader />
  </div>
</section>

<script>
  import { mountPatternWaves } from '../scripts/pattern-waves';
  import { mountTechText } from '../scripts/tech-text';
  import '../scripts/intro';

  const root = document.documentElement;

  const themeColors = () => {
    const css = getComputedStyle(root);
    return {
      ink: css.getPropertyValue('--ink').trim() || '#ffffff',
      bg: css.getPropertyValue('--bg').trim() || '#000000',
      font: css.getPropertyValue('--font-display').trim()
    };
  };

  const start = themeColors();

  // Configurazione scelta su React Bits (vedi CLAUDE.md), colori presi dal tema.
  const wavesEl = document.querySelector<HTMLElement>('[data-waves]');
  const waves = wavesEl
    ? mountPatternWaves(wavesEl, {
        preset: 'silk',
        color: start.ink,
        backgroundColor: start.bg,
        fade: 'edges',
        interactive: true,
        cursorSize: 50,
        cursorStrength: 0.6
      })
    : null;

  const titleEl = document.querySelector<HTMLElement>('[data-techtext]');
  const title = titleEl
    ? mountTechText(titleEl, {
        text: titleEl.dataset.text ?? 'Sasha',
        fontFamily: start.font,
        fontWeight: 600,
        fontSize: 150,
        reveal: 'letter',
        dashLength: 4,
        dashGap: 2,
        specks: 15,
        color: start.ink,
        accentColor: start.ink
      })
    : null;
  if (title) root.classList.add('techtext-ready');

  // Quando cambia il tema, i due canvas si ridisegnano con i nuovi colori.
  new MutationObserver(() => {
    const c = themeColors();
    waves?.set({ color: c.ink, backgroundColor: c.bg });
    title?.set({ color: c.ink, accentColor: c.ink });
  }).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    isolation: isolate;
  }

  .stage {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--bg);
  }

  .waves {
    position: absolute;
    inset: 0;
    transform-origin: center;
  }

  /* Velo in basso per leggere il testo sopra i puntini (come lo "scrim" di ScrollExpand) */
  .scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--bg) 85%, transparent),
      transparent 45%,
      color-mix(in srgb, var(--bg) 35%, transparent)
    );
  }

  .content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-top: 4rem; /* spazio per l'header */
    padding-bottom: var(--space-7);
  }

  .title-canvas {
    height: clamp(9rem, 32vh, 20rem);
    touch-action: pan-y;
    user-select: none;
  }

  /* Senza JavaScript (o se il canvas non parte) si vede il titolo in HTML */
  .title-text {
    font-size: clamp(4rem, 14vw, 9rem);
    text-align: center;
    letter-spacing: -0.05em;
    padding-top: var(--space-6);
  }

  :global(html.techtext-ready) .title-text {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  :global(html:not(.techtext-ready)) .title-canvas {
    display: none;
  }

  .headline {
    max-width: 22ch;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-3);
    line-height: 1.15;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .intro-loader {
    display: none;
  }

  /* ---------- Sequenza di ingresso ---------- */

  :global(html.intro) {
    overflow: hidden;
  }

  :global(html.intro) .stage {
    /* finestra iniziale di ScrollExpand: 42% × 58%, angoli da 24px */
    clip-path: inset(21% 29% round 24px);
    transition: clip-path 1100ms cubic-bezier(0.65, 0, 0.35, 1);
  }

  :global(html.intro) .waves {
    transform: scale(1.35);
    transition: transform 1100ms cubic-bezier(0.65, 0, 0.35, 1);
  }

  :global(html.intro) .scrim {
    opacity: 0;
    transition: opacity 1100ms ease;
  }

  :global(html.intro) .content,
  :global(html.intro .site-header) {
    opacity: 0;
    transform: translate3d(0, 18px, 0);
    transition:
      opacity 500ms ease,
      transform 500ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  :global(html.intro) .intro-loader {
    display: flex;
    justify-content: center;
    position: absolute;
    inset: auto 0 calc(21% - 3.5rem);
    transition: opacity 300ms ease;
  }

  :global(html.intro-open) .stage {
    clip-path: inset(0 0 0 0 round 0);
  }

  :global(html.intro-open) .waves {
    transform: none;
  }

  :global(html.intro-open) .scrim {
    opacity: 1;
  }

  :global(html.intro-open) .intro-loader {
    opacity: 0;
  }

  :global(html.intro-reveal) .content,
  :global(html.intro-reveal .site-header) {
    opacity: 1;
    transform: none;
  }

  /* Su telefono la finestra iniziale è più larga, altrimenti sarebbe minuscola */
  @media (max-width: 47.99rem) {
    :global(html.intro) .stage {
      clip-path: inset(24% 12% round 20px);
    }

    :global(html.intro) .intro-loader {
      inset: auto 0 calc(24% - 3.5rem);
    }

    :global(html.intro-open) .stage {
      clip-path: inset(0 0 0 0 round 0);
    }
  }
</style>
