---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  /** Sulla home l'header sta sopra lo sfondo animato e non mostra il nome (c'è già il titolo). */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
const path = Astro.url.pathname;
const isBlog = path.startsWith('/blog') || path.startsWith('/tag');
---

<header class:list={['site-header', { overlay }]}>
  <div class="container inner">
    {
      overlay ? (
        <span />
      ) : (
        <a class="name selectable" href="/">
          Sasha
        </a>
      )
    }
    <nav aria-label="Principale">
      <a class="selectable" href="/blog/" aria-current={isBlog ? 'page' : undefined}>{t('nav.blog')}</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 3;
    border-bottom: 1px solid var(--hairline);
  }

  .site-header.overlay {
    position: absolute;
    inset: 0 0 auto;
    border-bottom: 0;
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4rem;
  }

  .name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    color: var(--ink);
    text-decoration: none;
  }

  nav {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--space-3);
    color: var(--ink);
    text-decoration: none;
  }

  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-style: dashed;
    text-underline-offset: 0.35em;
  }
</style>
