---
// Elenco articoli (pagina Blog e pagine dei tag): un pannello con il titolo e le schede.
import PostCard from './PostCard.astro';
import type { PostItem } from '../lib/blog';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  items: PostItem[];
  title: string;
  description?: string;
  /** Etichetta sopra il titolo, es. «// Blog» */
  eyebrow?: string;
}

const { items, title, description, eyebrow } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
---

<div class="container page">
  <section class="panel" aria-labelledby="elenco-titolo">
    <header class="section-head intro">
      <div>
        {eyebrow && <p class="label">// {eyebrow}</p>}
        <h1 id="elenco-titolo">{title}</h1>
        {description && <p class="description">{description}</p>}
      </div>
    </header>

    {items.length === 0 && <p class="empty">{t('blog.empty')}</p>}

    <div class="list">
      {items.map((item) => <PostCard item={item} heading="h2" details />)}
    </div>
  </section>
</div>

<style>
  .page {
    padding-top: 6rem;
    padding-bottom: var(--space-5);
  }

  h1 {
    margin-top: var(--space-2);
  }

  .description {
    margin-top: var(--space-3);
    color: var(--muted);
    font-size: var(--step-1);
  }

  .list {
    display: grid;
    gap: var(--space-3);
  }

  .empty {
    color: var(--muted);
  }
</style>
