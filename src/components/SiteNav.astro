---
// Menu a pillola fisso in alto al centro: iniziale a sinistra, sezioni al centro,
// lingua e tema a destra. Su telefono le sezioni stanno in un pannello che si apre
// con «Menu». Sulla home si accende la voce della sezione visibile.
import Icon from './Icon.astro';
import { languages, type Lang } from '../i18n/ui';
import { getLangFromUrl, langPrefix, langs, localizePath, useTranslations } from '../i18n/utils';

interface Props {
  /** Indirizzo della stessa pagina nelle altre lingue (se diverso dal solo prefisso) */
  alternates?: Partial<Record<Lang, string>>;
}

const { alternates = {} } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const path = Astro.url.pathname;
const homePath = `${langPrefix(lang)}/`;
const isHome = path === homePath;

// Sulla home i link sono ancore; dalle altre pagine riportano alla home (gli articoli al blog).
const anchor = (id: string) => (isHome ? `#${id}` : `${homePath}#${id}`);
const items = [
  { id: 'progetti', label: t('nav.projects'), href: anchor('progetti') },
  { id: 'esperimenti', label: t('nav.lab'), href: anchor('esperimenti') },
  { id: 'percorso', label: t('nav.path'), href: anchor('percorso') },
  { id: 'studio', label: t('nav.its'), href: anchor('studio') },
  { id: 'articoli', label: t('nav.posts'), href: isHome ? '#articoli' : `${langPrefix(lang)}/blog/` },
  { id: 'contatti', label: t('nav.contact'), href: anchor('contatti') },
];
const isBlog = /\/(blog|tag)\//.test(path);
const isLab = /\/lab\//.test(path);
// Fuori dalla home si accende la voce della sezione a cui appartiene la pagina
const current = (id: string) => !isHome && ((isBlog && id === 'articoli') || (isLab && id === 'esperimenti'));
---

<header class="site-nav" data-site-nav data-home={isHome ? '' : undefined}>
  <nav class="bar" aria-label={t('nav.main')}>
    <a class="logo" href={homePath} aria-label={t('nav.home')}>S</a>

    <ul class="links" id="site-nav-links">
      {
        items.map((item) => (
          <li>
            <a
              href={item.href}
              data-section={isHome ? item.id : undefined}
              aria-current={current(item.id) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="tools">
      <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-nav-links">
        <span data-label-open>{t('nav.menu')}</span>
        <span data-label-close hidden>{t('nav.close')}</span>
      </button>

      <ul class="lang" aria-label={t('nav.lang')}>
        {
          langs.map((l) => (
            <li>
              <a
                href={alternates[l] ?? localizePath(path, l)}
                hreflang={l}
                lang={l}
                aria-current={l === lang ? 'true' : undefined}
                title={languages[l]}
              >
                <span aria-hidden="true">{l.toUpperCase()}</span>
                <span class="visually-hidden">{languages[l]}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <button
        class="theme"
        type="button"
        data-theme-toggle
        data-label-dark={t('theme.toDark')}
        data-label-light={t('theme.toLight')}
        aria-label={t('theme.toDark')}
      >
        <Icon name="sun" class="sun" />
        <Icon name="moon" class="moon" />
      </button>
    </div>
  </nav>
</header>

<script>
  const root = document.documentElement;
  const nav = document.querySelector<HTMLElement>('[data-site-nav]');

  // ---- Tema chiaro / scuro ----
  const toggle = nav?.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const system = window.matchMedia('(prefers-color-scheme: dark)');

  const applyTheme = (theme: 'light' | 'dark', save: boolean) => {
    root.dataset.theme = theme;
    if (save) {
      try {
        localStorage.setItem('theme', theme);
      } catch {
        // Storage bloccato: il tema vale fino alla chiusura della pagina.
      }
    }
    const bg = getComputedStyle(root).getPropertyValue('--bg').trim();
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', bg);
    if (toggle) toggle.setAttribute('aria-label', (theme === 'dark' ? toggle.dataset.labelLight : toggle.dataset.labelDark) ?? '');
    // Sfondo a onde e titolo TechText si ridisegnano con i colori nuovi
    document.dispatchEvent(new CustomEvent('themechange', { detail: theme }));
  };

  applyTheme(root.dataset.theme === 'dark' ? 'dark' : 'light', false);
  toggle?.addEventListener('click', () => applyTheme(root.dataset.theme === 'dark' ? 'light' : 'dark', true));

  // Se la persona non ha scelto, il sito segue il tema del sistema anche quando cambia.
  system.addEventListener('change', (e) => {
    let saved: string | null = null;
    try {
      saved = localStorage.getItem('theme');
    } catch {
      saved = null;
    }
    if (!saved) applyTheme(e.matches ? 'dark' : 'light', false);
  });

  // ---- Menu su telefono ----
  const button = nav?.querySelector<HTMLButtonElement>('.menu-button');
  const links = nav?.querySelector<HTMLElement>('.links');

  const setOpen = (open: boolean) => {
    if (!nav || !button) return;
    nav.toggleAttribute('data-open', open);
    button.setAttribute('aria-expanded', String(open));
    button.querySelector<HTMLElement>('[data-label-open]')!.hidden = open;
    button.querySelector<HTMLElement>('[data-label-close]')!.hidden = !open;
  };

  button?.addEventListener('click', () => setOpen(!nav?.hasAttribute('data-open')));
  links?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav?.hasAttribute('data-open')) {
      setOpen(false);
      button?.focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (nav?.hasAttribute('data-open') && !nav.contains(e.target as Node)) setOpen(false);
  });

  // ---- Home: si accende la voce della sezione che si sta leggendo ----
  if (nav?.hasAttribute('data-home')) {
    const anchors = new Map<string, HTMLElement>();
    nav.querySelectorAll<HTMLElement>('[data-section]').forEach((a) => anchors.set(a.dataset.section!, a));
    const sections = [...anchors.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => !!el);

    let scheduled = false;
    const update = () => {
      scheduled = false;
      const line = window.innerHeight * 0.35;
      let current: string | null = null;
      sections.forEach((s) => {
        if (s.getBoundingClientRect().top <= line) current = s.id;
      });
      anchors.forEach((a, id) => a.toggleAttribute('data-active', id === current));
    };
    update();
    window.addEventListener(
      'scroll',
      () => {
        if (scheduled) return;
        scheduled = true;
        requestAnimationFrame(update);
      },
      { passive: true }
    );
  }
</script>

<style>
  .site-nav {
    position: fixed;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 20;
    width: max-content;
    max-width: calc(100% - 2 * var(--space-4));
  }

  .bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding: 6px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--panel) 72%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }

  .logo {
    display: grid;
    place-items: center;
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--bg);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 17px;
    text-decoration: none;
  }

  ul {
    list-style: none;
    padding: 0;
  }

  .links {
    display: flex;
    gap: 2px;
    padding-inline: var(--space-2);
  }

  .links a,
  .menu-button {
    display: block;
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .links a:hover,
  .menu-button:hover {
    color: var(--ink);
    background: var(--line);
  }

  .links a[data-active],
  .links a[aria-current] {
    color: var(--ink);
    background: var(--line);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin-left: auto;
  }

  button {
    font: inherit;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .menu-button {
    display: none;
  }

  .lang {
    display: flex;
    padding: 3px;
    border-radius: var(--radius-pill);
    background: var(--line);
  }

  .lang a {
    display: grid;
    place-items: center;
    min-width: 36px;
    height: 32px;
    padding-inline: 8px;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--muted);
    text-decoration: none;
  }

  .lang a:hover {
    color: var(--ink);
  }

  .lang a[aria-current] {
    background: var(--panel-strong);
    color: var(--ink);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
  }

  .theme {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    color: var(--ink);
  }

  .theme:hover {
    background: var(--line);
  }

  .theme :global(svg) {
    width: 18px;
    height: 18px;
  }

  .theme :global(.moon),
  :global([data-theme='dark']) .theme :global(.sun) {
    display: none;
  }

  :global([data-theme='dark']) .theme :global(.moon) {
    display: block;
  }

  /* ---------- Telefono e tablet: sezioni nel pannello «Menu» ---------- */
  @media (max-width: 54rem) {
    .site-nav {
      width: calc(100% - 2 * var(--space-4));
    }

    .menu-button {
      display: block;
    }

    .links {
      display: none;
    }

    .site-nav[data-open] .links {
      display: grid;
      position: absolute;
      top: calc(100% + 8px);
      left: 0;
      right: 0;
      padding: var(--space-2);
      border-radius: var(--radius-card);
      background: var(--panel-strong);
      border: 1px solid var(--line);
      box-shadow: var(--shadow);
    }

    .site-nav[data-open] .links a {
      padding: 14px 16px;
      border-radius: 16px;
      font-size: 1rem;
      color: var(--ink);
    }
  }
</style>
