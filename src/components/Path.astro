---
// Schema del percorso (elemento firma, vedi DESIGN.md).
// Nodo pieno = fatto, nodo con centro = in corso, nodo vuoto = obiettivo.
// Il collegamento verso un nodo futuro è tratteggiato.
import type { PathStep } from '../data/it/profilo';

interface Props {
  steps: PathStep[];
}

const { steps } = Astro.props;

const stateLabel = {
  done: 'Fatto',
  current: 'In corso',
  next: 'Obiettivo',
} as const;
---

<section class="section" aria-labelledby="percorso-titolo">
  <div class="container">
    <h2 id="percorso-titolo">Percorso</h2>
    <ol class="path" style={`--count: ${steps.length}`}>
      {
        steps.map((step) => (
          <li data-state={step.state}>
            <span class="node" aria-hidden="true" />
            <span class="title">{step.title}</span>
            <span class="state">{step.label ?? stateLabel[step.state]}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-7);
  }

  h2 {
    margin-bottom: var(--space-6);
  }

  .path {
    --node: 14px;
    --stroke: 1.5px;
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-6);
  }

  li {
    position: relative;
    display: grid;
    grid-template-columns: var(--node) 1fr;
    column-gap: var(--space-4);
    align-items: start;
  }

  .node {
    grid-row: span 2;
    position: relative;
    z-index: 1;
    width: var(--node);
    height: var(--node);
    margin-top: 0.3em;
    border-radius: 50%;
    border: var(--stroke) solid var(--ink);
    background: var(--bg);
  }

  [data-state='done'] .node {
    background: var(--ink);
  }

  [data-state='current'] .node {
    background: radial-gradient(circle, var(--ink) 0 2.5px, var(--bg) 3px);
  }

  /* La tappa in corso è "selezionata", come la lettera sotto la lente di TechText */
  [data-state='current'] .node::after {
    content: '';
    position: absolute;
    inset: -7px;
    border: 1px solid color-mix(in srgb, var(--ink) 50%, transparent);
    background:
      linear-gradient(var(--ink), var(--ink)) top left / 4px 4px no-repeat,
      linear-gradient(var(--ink), var(--ink)) top right / 4px 4px no-repeat,
      linear-gradient(var(--ink), var(--ink)) bottom left / 4px 4px no-repeat,
      linear-gradient(var(--ink), var(--ink)) bottom right / 4px 4px no-repeat;
    background-origin: border-box;
  }

  [data-state='next'] .node {
    border-style: dashed;
    border-color: var(--muted);
  }

  .title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    line-height: 1.3;
  }

  .state {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--muted);
  }

  [data-state='current'] .state {
    color: var(--ink);
  }

  /* Collegamento alla tappa successiva: pieno dopo una tappa fatta, tratteggiato verso il futuro */
  li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: calc(var(--node) / 2 - var(--stroke) / 2);
    top: calc(0.3em + var(--node));
    height: calc(100% - var(--node) + var(--space-6));
    border-left: var(--stroke) solid var(--ink);
    transform-origin: top;
  }

  li:not([data-state='done'])::after {
    border-left-style: dashed;
    border-left-color: var(--muted);
  }

  @media (min-width: 48rem) {
    .section {
      padding-block: var(--space-8);
    }

    .path {
      grid-template-columns: repeat(var(--count, 4), 1fr);
      gap: var(--space-4);
    }

    li {
      grid-template-columns: 1fr;
      row-gap: var(--space-3);
    }

    .node {
      grid-row: auto;
      margin-top: 0;
    }

    li:not(:last-child)::after {
      left: calc(var(--node) + 10px);
      top: calc(var(--node) / 2 - var(--stroke) / 2);
      width: calc(100% - var(--node) - 20px + var(--space-4));
      height: 0;
      border-left: 0;
      border-top: var(--stroke) solid var(--ink);
      transform-origin: left;
    }

    li:not([data-state='done'])::after {
      border-top-style: dashed;
      border-top-color: var(--muted);
    }
  }
</style>
