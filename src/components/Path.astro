---
// 02 Percorso: le tappe in fila. Orizzontale da 54rem, verticale su telefono.
// Punto pieno = fatto, punto con anello = in corso, punto vuoto = obiettivo.
import type { PathStep } from '../data/profilo';
import { getLangFromUrl, pick, useTranslations } from '../i18n/utils';

interface Props {
  steps: PathStep[];
}

const { steps } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const stateLabel = { done: t('state.done'), current: t('state.current'), next: t('state.next') };
// Fin dove arriva la linea colorata: fino alla tappa in corso (o all'ultima fatta)
const reached = Math.max(
  steps.findIndex((s) => s.state === 'current'),
  steps.map((s) => s.state).lastIndexOf('done')
);
---

<section id="percorso" class="panel" aria-labelledby="percorso-titolo">
  <div class="section-head">
    <div>
      <p class="label"><span class="num">02</span> // {t('nav.path')}</p>
      <h2 id="percorso-titolo">{t('path.title')}</h2>
    </div>
  </div>

  <ol class="timeline" style={`--steps: ${steps.length}`}>
    {
      steps.map((step, i) => (
        <li
          class="step"
          data-state={step.state}
          data-reached={i < reached ? '' : undefined}
          aria-current={step.state === 'current' ? 'step' : undefined}
        >
          <span class="node" aria-hidden="true" />
          <p class="label">{stateLabel[step.state]}</p>
          <h3>{pick(step.title, lang)}</h3>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .timeline {
    --node: 20px;
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--steps), minmax(0, 1fr));
    gap: var(--space-4);
    list-style: none;
    padding: 0;
  }

  /* Linea: un segmento da ogni tappa alla successiva, colorato fino alla tappa in corso */
  .step:not(:last-child)::before {
    content: '';
    position: absolute;
    top: calc(var(--node) / 2 - 1px);
    left: var(--node);
    width: calc(100% + var(--space-4) - var(--node));
    height: 2px;
    background: var(--line);
  }

  .step[data-reached]::before {
    background: var(--accent);
  }

  .step {
    position: relative;
    padding-top: calc(var(--node) + var(--space-4));
  }

  .node {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--node);
    height: var(--node);
    border-radius: 50%;
    background: var(--panel-strong);
    border: 2px solid color-mix(in srgb, var(--muted) 45%, transparent);
  }

  .step[data-state='done'] .node {
    background: var(--accent);
    border-color: var(--accent);
  }

  .step[data-state='current'] .node {
    border-color: var(--accent);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 20%, transparent);
  }

  .step[data-state='current'] .node::after {
    content: '';
    position: absolute;
    inset: 3px;
    border-radius: 50%;
    background: var(--accent);
  }

  .step[data-state='current'] .label {
    color: var(--accent-text);
  }

  h3 {
    margin-top: var(--space-1);
    font-size: var(--step-1);
  }

  @media (max-width: 54rem) {
    .timeline {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .step:not(:last-child)::before {
      top: var(--node);
      bottom: 0;
      left: calc(var(--node) / 2 - 1px);
      width: 2px;
      height: auto;
    }

    .step {
      padding: 0 0 var(--space-6) calc(var(--node) + var(--space-4));
    }

    .step:last-child {
      padding-bottom: 0;
    }
  }
</style>
